<archetype-descriptor xmlns="http://maven.apache.org/plugin-tools/archetype-descriptor/1.1.0"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="http://maven.apache.org/plugin-tools/archetype-descriptor/1.1.0 http://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
                      name="itara-archetype-component-api">

    <requiredProperties>
        <requiredProperty key="componentName">
            <!-- PascalCase, e.g. "Calculator" — names the interface -->
        </requiredProperty>
        <requiredProperty key="javaVersion">
            <defaultValue>21</defaultValue>
        </requiredProperty>
        <requiredProperty key="itaraVersion">
            <!-- No default — versions change frequently pre-1.0, must be supplied at generation time -->
        </requiredProperty>
    </requiredProperties>

    <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="false" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>
        <fileSet filtered="true" packaged="false" encoding="UTF-8">
            <directory/>
            <includes>
                <include>*.itara</include>
            </includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>