<archetype-descriptor xmlns="http://maven.apache.org/plugin-tools/archetype-descriptor/1.1.0"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="http://maven.apache.org/plugin-tools/archetype-descriptor/1.1.0 http://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
                      name="itara-archetype-component">

    <requiredProperties>
        <requiredProperty key="componentName">
            <!-- PascalCase, e.g. "Calculator" — names the interface (Calculator), impl (CalculatorImpl), and activator (CalculatorActivator) -->
        </requiredProperty>
        <requiredProperty key="javaVersion">
            <defaultValue>21</defaultValue>
        </requiredProperty>
        <requiredProperty key="itaraVersion">
            <!-- No default — versions change frequently pre-1.0, must be supplied at generation time -->
        </requiredProperty>
    </requiredProperties>

    <modules>
        <module id="${rootArtifactId}-api" dir="__rootArtifactId__-api" name="${rootArtifactId}-api">
            <fileSets>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/main/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="false" encoding="UTF-8">
                    <directory>src/main/resources</directory>
                    <includes>
                        <include>**/*</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="false" encoding="UTF-8">
                    <directory/>
                    <includes>
                        <include>*.itara</include>
                    </includes>
                </fileSet>
            </fileSets>
        </module>
        <module id="${rootArtifactId}-component" dir="__rootArtifactId__-component" name="${rootArtifactId}-component">
            <fileSets>
                <fileSet filtered="true" packaged="true" encoding="UTF-8">
                    <directory>src/main/java</directory>
                    <includes>
                        <include>**/*.java</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="false" encoding="UTF-8">
                    <directory>src/main/resources</directory>
                    <includes>
                        <include>**/*</include>
                    </includes>
                </fileSet>
                <fileSet filtered="true" packaged="false" encoding="UTF-8">
                    <directory/>
                    <includes>
                        <include>*.itara</include>
                    </includes>
                </fileSet>
            </fileSets>
        </module>
    </modules>
</archetype-descriptor>