[artifact]
kind = "component"
id = "order-consumer"
version = "0.1.0"

[runtime]
language = "java"

[itara]
spec-version = "0.2"

[implemented-event-contracts]
contracts = [
  { id = "order-events/order-placed", version = "0.1.0" },
  { id = "order-events/order-cancelled", version = "0.1.0" },
  { id = "payment-events/payment-made", version = "0.1.0" }
]