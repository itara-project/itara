[artifact]
kind = "api"
id = "inventory"
version = "0.1.0"
api-version = "0.1.0"

[runtime]
language = "java"
compiler = "21"

[itara]
spec-version = "0.1"
core-version = "0.1+"

[methods]
non-idempotent = ["addItem", "reserveOrder"]
# checkAvailability is idempotent — read-only, no side effects
# for the sake of the demo, releaseReservation is also idempotent
