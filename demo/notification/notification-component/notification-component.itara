[artifact]
kind = "component"
id = "notification"
version = "0.1.0"
api-version = "0.1.0"

[runtime]
language = "java"
compiler = "21"

[itara]
spec-version = "0.1"
core-version = "0.1+"

[implemented-event-contracts]
contracts = [
  { id = "order-events/order-reserved", version = "1.0-SNAPSHOT" },
  { id = "fulfilment-events/order-cancelled", version = "1.0-SNAPSHOT" },
  { id = "fulfilment-events/order-fulfilled", version = "1.0-SNAPSHOT" }
]
